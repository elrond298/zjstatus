layout {
    pane split_direction="vertical" {
        pane
    }

    pane size=3 borderless=true {
        plugin location="file:target/wasm32-wasip1/debug/zjstatus.wasm" {
            color_blue   "#89B4FA"
            color_yellow "yellow"
            color_bg     "#181825"
            color_panel  "#181825"

            format_left               "{mode}#[fg=$blue,bg=$bg,bold] {session}"
            format_center             "{tabs} {command_3} {pipe_1}"
            format_right              "{notifications}{datetime}"
            format_responsive         "true"
            format_left_1             "{mode}#[fg=$blue,bg=$bg,bold] {session}"
            format_left_2             "{mode}"
            format_left_3             ""
            format_left_4             ""
            format_center_1           "{tabs}"
            format_center_2           "{tabs}"
            format_center_3           "{tabs}"
            format_center_4           "{tabs}"
            format_right_1            "{notifications}"
            format_right_2            "{notifications}"
            format_right_3            "{notifications}"
            format_right_4            "{notifications}"
            format_space              "#[bg=$bg]"
            hint_mode_format          "#[fg=$blue,bg=$bg,bold]"
            hint_key_format           "#[fg=$yellow,bg=$bg,bold]"
            hint_desc_format          "#[fg=#CDD6F4,bg=$bg]"
            hint_space_format         "#[bg=$bg]"
            hint_idle_left          "vcs pi"
            hint_idle_right         "load"
            hint_idle_separator     "#[bg=$panel]  "
            hint_idle_vcs_command   "vcs"
            hint_idle_vcs_reductions "0 4 5 6"
            hint_idle_load_command  "load"
            hint_idle_load_reductions "1 2 3"
            hint_idle_pi_command    "pi"
            hint_idle_pi_reductions "7 8 9"
            format_precedence         "lrc"
            format_hide_on_overlength "false"

            notification_format_unread "#[fg=$blue,bg=$bg,blink]  #[fg=$blue,bg=$bg] {message} "
            notification_format_no_notifications "#[fg=$blue,bg=$bg,dim]   "
            notification_show_interval "10"

            pipe_1_format "#[fg=red] {output}"

            border_enabled  "true"
            border_char     "─"
            border_format   "#[fg=#6C7086]{char}"
            border_position "top"

            swap_layout_format        "#[bg=blue,fg=#000000] {name} #[bg=red,fg=black] foo "
            swap_layout_hide_if_empty "false"

            hide_frame_for_single_pane       "false"
            hide_frame_except_for_search     "true"
            hide_frame_except_for_fullscreen "false"
            hide_frame_except_for_scroll     "true"

            mode_normal          "#[bg=$blue] #[bg=yellow] "
            mode_tmux            "#[bg=$yellow] "
            mode_default_to_mode "tmux"

            tab_normal              "#[fg=#6C7086,bg=$bg] {index} {name} {floating_indicator}{bell_indicator} "
            tab_rename              "#[fg=#eba0ac,bg=$bg] {index} {name} {floating_indicator} "
            tab_normal_fullscreen   "#[fg=#6C7086,bg=$bg] {index} {name} [] "
            tab_normal_sync         "#[fg=#6C7086,bg=$bg] {index} {name} <> "
            tab_normal_bell         "#[fg=#f38ba8,bg=$bg,bold] {index} {name} {bell_indicator} "
            tab_normal_flashing_bell "#[fg=$bg,bg=#f38ba8,bold] {index} {name} {bell_indicator} "
            tab_active              "#[fg=#9399B2,bg=$bg,bold,italic] {index} {name} {floating_total_count}{floating_indicator}{sync_indicator}{fullscreen_indicator}"
            tab_locator_format      "#[fg=$blue,bg=$bg,bold]{left_arrow}{index}{right_arrow}"
            tab_locator_compact_format "#[fg=$blue,bg=$bg,bold]{index}"
            tab_separator           "#[fg=#6C7086,bg=$bg] | "
            tab_floating_indicator  "F"
            tab_sync_indicator      "S"
            tab_fullscreen_indicator "FS"
            tab_bell_indicator       "!"
            tab_flashing_bell_indicator "!!"
            tab_display_count       "3"
            tab_truncate_start_format "#[fg=$blue,bg=$bg]#[bg=$blue,fg=black] +{count} ... #[fg=$bg,bg=$blue]"
            tab_truncate_end_format "#[fg=red,bg=$bg] ... +{count} > #[bg=$yellow] "
            tab_zero_based_index "false"

            command_0_command      "echo \"平仮名, ひらがな 📦\""
            command_0_clickaction "bash -c \"zellij --session zjstatus-dev pipe 'zjstatus::notify::hello world!' -n zjstatus\""
            command_0_format       "#[fg=colour80] {exit_code} #[fg=colour90] {stdout} "
            command_0_interval     "1"

            command_1_command   "date"
            command_1_format    "#[fg=blue,reverse,bg=default,us=red,blink,dim,strikethrough] {exit_code} {stdout} "
            command_1_interval  "1"

            command_vcs_command            "/mnt/wsl/PHYSICALDRIVE0p1/opt/zjstatus/examples/vcs-status.sh"
            command_vcs_cwd                "{focused_pane_cwd}"
            command_vcs_format             "{stdout}"
            command_vcs_rendermode         "raw"
            command_vcs_interval           "2"
            command_vcs_hideonemptystdout  "true"
            command_pi_command             "/mnt/wsl/PHYSICALDRIVE0p1/opt/zjstatus/examples/pi-status.sh"
            command_pi_format              "{stdout}"
            command_pi_rendermode          "raw"
            command_pi_interval            "2"
            command_pi_hideonemptystdout   "true"
            command_load_command           "/mnt/wsl/PHYSICALDRIVE0p1/opt/zjstatus/examples/host-load.sh"
            command_load_format            "{stdout}"
            command_load_rendermode        "raw"
            command_load_interval          "2"
            command_git_branch_command   "bash -c \"echo $FOO\""
            command_git_branch_cwd       "/Users/daniel"
            command_git_branch_env       {
                FOO "1"
                BAR "foo"
            }
            command_git_branch_format    "#[fg=red] {stdout} "
            command_git_branch_interval  "2"

            command_3_command   "echo -e \"#[fg=$yellow,italic,bold] foo #[dim,bold,italic] bar \""
            command_3_format    "{stdout}"
            command_3_interval  "10"
            command_3_rendermode "dynamic"

            datetime             "#[fg=#6C7086,bg=$bg,bold] {format} #[bg=#6C7086,fg=$bg,bold] {time}"
            datetime_time_format "%H:%M:%S"
            datetime_format      "%A, %d %b %Y %H:%M"
            datetime_timezone    "Europe/Berlin"
        }
    }
}
